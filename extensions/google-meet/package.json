{
  "name": "@aether/google-meet",
  "version": "2026.9.4",
  "description": "Aether Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aether/aether"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.1",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@aether/plugin-sdk": "workspace:*",
    "aether": "workspace:*"
  },
  "peerDependencies": {
    "aether": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "aether": {
      "optional": true
    }
  },
  "aether": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@aether/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "aetherVersion": "2026.9.4"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
