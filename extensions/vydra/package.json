{
  "name": "@aether/vydra-provider",
  "version": "2026.9.4",
  "description": "Aether Vydra media provider plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aether/aether"
  },
  "type": "module",
  "devDependencies": {
    "@aether/plugin-sdk": "workspace:*"
  },
  "aether": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@aether/vydra-provider",
      "npmSpec": "@aether/vydra-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.2"
    },
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "aetherVersion": "2026.9.4",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
