{
  "name": "@aether/anthropic-vertex-provider",
  "version": "2026.9.4",
  "description": "Aether Anthropic Vertex provider plugin for Claude models on Google Vertex AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aether/aether"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "0.19.6",
    "google-auth-library": "10.9.1",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@aether/plugin-sdk": "workspace:*"
  },
  "aether": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@aether/anthropic-vertex-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "aetherVersion": "2026.9.4",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
