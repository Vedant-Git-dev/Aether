{
  "name": "@aether/workboard",
  "version": "2026.9.4",
  "private": true,
  "description": "Aether dashboard workboard plugin",
  "type": "module",
  "dependencies": {
    "typebox": "1.3.18",
    "@aether/gateway-protocol": "workspace:*",
    "@aether/workboard-contract": "workspace:*",
    "lit": "3.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aether/gateway-client": "workspace:*",
    "@aether/normalization-core": "workspace:*",
    "@aether/plugin-sdk": "workspace:*",
    "aether": "workspace:*"
  },
  "peerDependencies": {
    "aether": ">=2026.9.4"
  },
  "peerDependenciesMeta": {
    "aether": {
      "optional": true
    }
  },
  "aether": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts",
      "copy": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts --copy",
      "buildOutputs": [
        "aether.plugin.json"
      ]
    }
  }
}
