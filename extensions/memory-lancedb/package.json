{
  "name": "@aether/memory-lancedb",
  "version": "2026.9.4",
  "description": "Aether LanceDB-backed long-term memory plugin with auto-recall, auto-capture, and vector search.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aether/aether"
  },
  "type": "module",
  "dependencies": {
    "apache-arrow": "18.1.0",
    "openai": "7.8.0",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@lancedb/lancedb": "0.37.1",
    "@aether/plugin-sdk": "workspace:*"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "0.37.1",
    "@lancedb/lancedb-linux-arm64-gnu": "0.37.1",
    "@lancedb/lancedb-linux-arm64-musl": "0.37.1",
    "@lancedb/lancedb-linux-x64-gnu": "0.37.1",
    "@lancedb/lancedb-linux-x64-musl": "0.37.1",
    "@lancedb/lancedb-win32-arm64-msvc": "0.37.1",
    "@lancedb/lancedb-win32-x64-msvc": "0.37.1"
  },
  "aether": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@aether/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.31"
    },
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "aetherVersion": "2026.9.4"
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
