# Aether environment
#
# Copy this file to .env (it is gitignored). Structure belongs in config.yaml.
#
# Minimum to boot: DATABASE_URL, AETHER_ENCRYPTION_KEY, and AETHER_TOKEN.
#
# Most app keys do not need this file at all. Send /apps in chat, follow the
# link it gives, and paste the key there. A paste is used before the agent
# sees it, is stored encrypted, and takes precedence over this file.
#
# Generate a key with:
#   python -c "from aether.memory.crypto import generate_key_b64; print(generate_key_b64())"

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# Any Postgres database. Neon's free tier works, and so does a local one.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Base64 of 32 random bytes. Encrypts content at rest. Losing it loses the data.
AETHER_ENCRYPTION_KEY=

# Guards the API, WebSocket chat, and companion uploads. One shared secret.
AETHER_TOKEN=change-me

# The port to serve on. Defaults to 8000.
# PORT=8000

# This deployment's public address. Needed only for the GitHub Actions batch
# queue, so a runner can call back.
# AETHER_PUBLIC_URL=https://your-app.example.com

# Throwaway development only: use a key that changes every boot. Never for
# real data, because the next boot cannot read what this one wrote.
# AETHER_DEV_EPHEMERAL_KEY=1

# Path to a config file other than ./config.yaml.
# AETHER_CONFIG=config.yaml

# ---------------------------------------------------------------------------
# Direct app connections (optional)
# ---------------------------------------------------------------------------

# Aether owns the OAuth client and stores tokens encrypted. Without this
# keyring, Gmail, Calendar, Drive, Docs, GitHub, and LinkedIn stay disabled.
# Base64 of 32 random bytes, separate from AETHER_ENCRYPTION_KEY.
AETHER_TOKEN_ENCRYPTION_KEY=

# A short label for the active key, like 2026-10
AETHER_TOKEN_ENCRYPTION_KEY_ID=

# Previous key, only during rotation.
# AETHER_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# AETHER_TOKEN_ENCRYPTION_KEY_PREVIOUS_ID=

# Google OAuth client. /apps add gmail can collect this from chat instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Picker, used by Drive and Docs. Can also be saved from Apps.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# GitHub OAuth App (optional; a fine-grained token works by default)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth app (personal posting only; tokens last about 60 days)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Rotating the token key later:
#   python -m aether.providers.rotate_tokens --check

# ---------------------------------------------------------------------------
# LLM providers (set the one matching llm.provider in config.yaml)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Custom endpoints. Both providers already default to the values below.
# Uncomment only to point at a different server.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# Tools (optional)
# ---------------------------------------------------------------------------

# Web search on Tavily's free tier. Without it, web_search refuses in plain
# words; web_fetch still works.
TAVILY_API_KEY=

# Voice-note transcription through Groq (whisper-large-v3).
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Background sandboxes (optional)
# ---------------------------------------------------------------------------

# Modal is the default workbench. Both halves are needed.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Vercel is the fallback sandbox.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# GitHub Actions batch queue. Also set workbench.actions_repo,
# workbench.actions_workflow, and AETHER_PUBLIC_URL.
GITHUB_ACTIONS_TOKEN=

# ---------------------------------------------------------------------------
# Messaging (optional; also enable in config.yaml)
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
