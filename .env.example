# Aether environment
#
# Copy this file to .env (it is gitignored). Structure belongs in config.yaml.
#
# Minimum to boot: DATABASE_URL, AETHER_ENCRYPTION_KEY, and AETHER_TOKEN.
#
# Most app keys do not need this file at all. Send /apps in chat, follow the
# link it gives, and paste the key there. A paste is used before the agent
# sees it, is stored encrypted, and takes precedence over this file.
#
# Generate a key with:
#   python -c "from aether.memory.crypto import generate_key_b64; print(generate_key_b64())"

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# Neon connection string (free tier: https://neon.tech)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# base64 of 32 random bytes
AETHER_ENCRYPTION_KEY=

# Guards the API, WebSocket chat, and companion uploads
AETHER_TOKEN=change-me

# ---------------------------------------------------------------------------
# Direct app connections (optional)
# ---------------------------------------------------------------------------

# Aether owns the OAuth client and stores tokens encrypted.
# base64 of 32 random bytes, separate from AETHER_ENCRYPTION_KEY
AETHER_TOKEN_ENCRYPTION_KEY=

# A short label for the active key, like 2026-10
AETHER_TOKEN_ENCRYPTION_KEY_ID=

# Google OAuth client. /apps add gmail can collect this from chat instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Picker, used by Drive and Docs. Can also be saved from Apps.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# GitHub OAuth App (optional; a fine-grained token works by default)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth app (personal posting only; tokens last about 60 days)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Rotating the token key later:
#   python -m aether.providers.rotate_tokens --check

# ---------------------------------------------------------------------------
# LLM providers (set the one matching llm.provider in config.yaml)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Custom endpoints. Both providers already default to the values below.
# Uncomment only to point at a different server.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---------------------------------------------------------------------------
# Messaging (optional; also enable in config.yaml)
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
