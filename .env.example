# Aether environment. Copy to .env (gitignored). Structure belongs in config.yaml.
# Each field is marked REQUIRED, conditionally required, or optional with its default.

# --- Core -------------------------------------------------------------------

# REQUIRED Postgres connection string. Keep sslmode=require.
DATABASE_URL=

# REQUIRED base64 of 32 random bytes. Encrypts content at rest.
# Generate: python -c "from aether.memory.crypto import generate_key_b64; print(generate_key_b64())"
AETHER_ENCRYPTION_KEY=

# optional (default: k1) label for the active content key
# AETHER_ENCRYPTION_KEY_ID=2026-10
# optional (default: unset) previous key, only during rotation
# AETHER_ENCRYPTION_KEY_PREVIOUS=
# optional (default: unset)
# AETHER_ENCRYPTION_KEY_PREVIOUS_ID=

# REQUIRED shared token for the API, web chat and companion uploads.
AETHER_TOKEN=

# optional (default: 8000)
# PORT=8000
# optional (default: empty) public address, required for the GitHub Actions queue
# AETHER_PUBLIC_URL=
# optional (default: unset) throwaway dev key, never for real data
# AETHER_DEV_EPHEMERAL_KEY=1
# optional (default: config.yaml)
# AETHER_CONFIG=config.yaml

# --- Model providers --------------------------------------------------------
# conditionally required: the key for the provider set in llm.provider.
# Ollama needs no key (it listens on OLLAMA_BASE_URL).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# optional (default: http://localhost:11434/v1)
# OLLAMA_BASE_URL=
# optional (default: https://integrate.api.nvidia.com/v1)
# NVIDIA_BASE_URL=

# --- Chat surfaces ----------------------------------------------------------
# conditionally required: the token for each surface enabled in config.yaml.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Direct app connections -------------------------------------------------
# optional (default: disabled) needs AETHER_TOKEN_ENCRYPTION_KEY either way.
AETHER_TOKEN_ENCRYPTION_KEY=
# optional (default: unset) label for the active token key
AETHER_TOKEN_ENCRYPTION_KEY_ID=
# optional (default: unset) previous token key, only during rotation
# AETHER_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# AETHER_TOKEN_ENCRYPTION_KEY_PREVIOUS_ID=

# optional (default: unset) Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# optional (default: unset) GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional (default: unset) LinkedIn OAuth app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Tools ------------------------------------------------------------------
# conditionally required: set when web search is used.
TAVILY_API_KEY=
# conditionally required: set when voice notes are transcribed.
GROQ_API_KEY=

# --- Background sandboxes ---------------------------------------------------
# conditionally required: the keys for the workbench.provider you choose.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
GITHUB_ACTIONS_TOKEN=
